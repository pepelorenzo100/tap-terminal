            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+523141234567\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Bitácora (Audit Log)",
      "item": [
        {
          "name": "Listar bitácora",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/audit-logs",
              "host": ["{{base_url}}"],
              "path": ["api", "audit-logs"]
            },
            "description": "Solo lectura. Los registros se generan automáticamente mediante el trait Auditable en los modelos Product, User, AccessProfile."
          }
        },
        {
          "name": "Filtrar bitácora por entidad",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/audit-logs?entity=products",
              "host": ["{{base_url}}"],
              "path": ["api", "audit-logs"],
              "query": [{ "key": "entity", "value": "products" }]
            }
          }
        },
        {
          "name": "Filtrar bitácora por rango de fechas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/audit-logs?entity=users&from=2026-08-01&to=2026-08-25",
              "host": ["{{base_url}}"],
              "path": ["api", "audit-logs"],
              "query": [
                { "key": "entity", "value": "users" },
                { "key": "from", "value": "2026-08-01" },
                { "key": "to", "value": "2026-08-25" }
              ]
            }
          }
        }
      ]
    }
  ]
}
